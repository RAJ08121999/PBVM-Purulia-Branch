# Environment Variables - PBVM Purulia Backend
# Copy this file to .env and fill in your real values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=your_mongodb_connection_string

# JWT Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Default admin seeding
DEFAULT_ADMIN_EMAIL=admin@pbvmpurulia.org
DEFAULT_ADMIN_PASSWORD=your_default_admin_password
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_RESET_PASSWORD=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# =================================================
# Brevo Email Transaction Credentials
# =================================================
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME="PBVM Purulia"
BREVO_SENDER_EMAIL=your_sender_email@example.com

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,https://pbvm-purulia-branch.vercel.app
LOGO_URL=https://pbvm-purulia-branch.vercel.app/logo.png
